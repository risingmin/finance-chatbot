# Backend environment variables
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# LLM configuration (Gemma API from Google AI Studio)
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=your-google-ai-studio-api-key-here

# Frontend environment variables
# For local dev, leave empty to use Vite proxy (http://localhost:8000)
# For production, set to your backend URL, e.g., https://api.example.com
VITE_API_URL=